# Python & caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.env/
.venv/

# Jupyter / data science
.ipynb_checkpoints/
*.ipynb

# Model binaries (regenerate with scripts)
models/*.pkl
models/*.pt
models/*.pth

# Large PyG graph snapshots (regenerate with graph_builder.py)
data/graphs/*.pt

# Raw data downloads (re-downloadable)
data/raw/*.csv
data/raw/*.PDF
data/raw/*.pdf
data/raw/*.XLSX
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.XLS

# Keep rbi_fsr folder structure but not the files
!data/raw/rbi_fsr/.gitkeep

# Output images (regenerated by pipeline)
outputs/

# OS & editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/

# Don't ignore processed data, results, or source
!data/processed/
!results/
!web/

# Vercel & env
.vercel
.env*
