{
  "version": 2,
  "functions": {
    "api/live_score.py": {
      "includeFiles": "models/**,data/processed/**",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/live_score",
      "dest": "/api/live_score.py"
    },
    {
      "src": "/data/(.*)",
      "dest": "/web/data/$1"
    },
    {
      "src": "/style.css",
      "dest": "/web/style.css"
    },
    {
      "src": "/app.js",
      "dest": "/web/app.js"
    },
    {
      "src": "/outputs/(.*)",
      "dest": "/outputs/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/web/index.html"
    }
  ]
}
